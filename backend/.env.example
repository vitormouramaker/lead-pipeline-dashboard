# Copie para .env (cp .env.example .env). Os valores abaixo já funcionam localmente.

NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=painel_leads

# Assinatura dos tokens de login (mínimo 32 caracteres). Obrigatório em produção.
# Em desenvolvimento, se ficar vazio, a API gera um segredo aleatório a cada subida.
JWT_SECRET=segredo-local-somente-para-demonstracao-0001
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS (separe várias por vírgula)
CORS_ORIGIN=http://localhost:3000

# Tamanho máximo da planilha enviada, em MB
UPLOAD_MAX_MB=5

# Senha da conta de demonstração criada por npm run seed:demo (padrão Demo@1234)
# DEMO_SENHA=
